#include <winver.h>

#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     TNE_FILE_VERSION
PRODUCTVERSION  TNE_FILE_VERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704B0"
        BEGIN
            VALUE "FileDescription", TNE_FILE_DESCRIPTION
            VALUE "FileVersion", TNE_FILE_VERSION_STR
            VALUE "InternalName", TNE_INTERNAL_NAME
            VALUE "LegalCopyright", TNE_LEGAL_COPYRIGHT_RC
            VALUE "OriginalFilename", TNE_ORIGINAL_FILENAME
            VALUE "ProductName", TNE_PRODUCT_NAME
            VALUE "ProductVersion", TNE_FILE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0407, 1200
    END
END
